# Application Environment (development, staging, production)
APP_ENV=development

# Database Connection (Neon PostgreSQL with pgvector extension)
# Note: For Neon, use the pooled or direct connection string with sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-NEON-HOST/DB_NAME?sslmode=require

# xAI Grok Configuration
# Documentation: https://docs.x.ai/overview
XAI_API_KEY=replace-with-your-xai-api-key
XAI_API_BASE=https://api.x.ai/v1
XAI_MODEL=grok-4.7
XAI_TIMEOUT_SECONDS=90

# Alternative LLM Provider: Groq
# GROQ_API_KEY=replace-with-your-groq-api-key
# GROQ_MODEL=qwen/qwen3.8-27b

# Jina AI Embeddings & Reranker Configuration
# JINA_API_KEY=replace-with-your-jina-api-key
# JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
# JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK_ENABLED=true

# Hugging Face Inference API / Feature Extraction Configuration
# Documentation: https://huggingface.co/docs/inference-providers/en/tasks/feature-extraction
HF_TOKEN=replace-with-your-huggingface-token
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
HF_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=16

# MITRE Knowledge Base Local Cache Paths
ATTACK_STIX_FILE=./data/enterprise-attack.json
D3FEND_FILE=./data/d3fend.json

# Operational Modes
DEMO_MODE=true
LOG_LEVEL=INFO
