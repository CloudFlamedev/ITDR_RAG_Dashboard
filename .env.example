# Application Environment (development, staging, production)
APP_ENV=development

# Database Connection (Neon PostgreSQL with pgvector extension)
# Note: For Neon, use the pooled or direct connection string with sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-NEON-HOST/DB_NAME?sslmode=require

# Session & Cookie Security
SESSION_SECRET_KEY=replace-with-a-random-32-byte-hex-or-base64-secret
SESSION_EXPIRE_MINUTES=720
SESSION_INACTIVITY_MINUTES=30
SESSION_COOKIE_NAME=itdr_session
CSRF_COOKIE_NAME=itdr_csrf
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGIN_WHITELIST=http://localhost:5173,http://127.0.0.1:5173,https://itdr-rag-dashboard.vercel.app
FRONTEND_URL=http://localhost:5173

# Rate Limiting (Failed Login Attempts)
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900

# Social Authentication: Google OIDC (with PKCE S256)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback

# Social Authentication: GitHub OAuth 2.0
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/oauth/github/callback

# Public Registration & Social Sign-up Policies
PUBLIC_REGISTRATION_ENABLED=true
ALLOW_OAUTH_AUTO_REGISTRATION=true
DEFAULT_REGISTRATION_ROLE=Demo Analyst

# Email Delivery & Verification
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@itdr-platform.local
EMAIL_VERIFICATION_EXPIRE_MINUTES=30
# SMTP Settings (optional, only needed if EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_TLS=true

# Usage Limits for Demo Analyst Accounts
DAILY_ANALYSIS_LIMIT=5
MAX_ADVISORY_CHARS=15000

# xAI Grok Configuration
# Documentation: https://docs.x.ai/overview
XAI_API_KEY=replace-with-your-xai-api-key
XAI_API_BASE=https://api.x.ai/v1
XAI_MODEL=grok-4.7
XAI_TIMEOUT_SECONDS=90

# Alternative LLM Provider: Groq
# GROQ_API_KEY=replace-with-your-groq-api-key
# GROQ_MODEL=qwen/qwen3.8-27b

# Jina AI Embeddings & Reranker Configuration
# JINA_API_KEY=replace-with-your-jina-api-key
# JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
# JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK_ENABLED=true

# Hugging Face Inference API / Feature Extraction Configuration
# Documentation: https://huggingface.co/docs/inference-providers/en/tasks/feature-extraction
HF_TOKEN=replace-with-your-huggingface-token
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
HF_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=16

# MITRE Knowledge Base Local Cache Paths
ATTACK_STIX_FILE=./data/enterprise-attack.json
D3FEND_FILE=./data/d3fend.json

# Operational Modes
DEMO_MODE=true
LOG_LEVEL=INFO
